                          <td className="p-2 border-r border-catalyst-gray-200 text-catalyst-gray-700">
                            {editingRow === deal.id ? (
                              <Input
                                value={editData.brokerName || `${deal.broker.firstName} ${deal.broker.lastName}`}
                                onChange={(e) => setEditData({...editData, brokerName: e.target.value})}
                                className="h-8 text-xs"
                                placeholder="Broker name..."
                              />
                            ) : editingCell?.dealId === deal.id && editingCell?.field === 'brokerName' ? (
                              <Input
                                value={cellEditValue}
                                onChange={(e) => setCellEditValue(e.target.value)}
                                onBlur={saveCellEdit}
                                onKeyDown={handleCellKeyPress}
                                className="h-8 text-xs"
                                placeholder="Broker name..."
                                autoFocus
                              />
