                                      className="text-catalyst-gold hover:text-catalyst-navy transition-colors"
                                      title={`Call ${deal.broker.phone}`}
                                      onClick={(e) => e.stopPropagation()}
                                    >
                                      {deal.broker.phone}
                                    </a>
                                    <a 
                                      href={`sms:${deal.broker.phone.replace(/[^\d]/g, '')}`}
                                      className="text-gray-400 hover:text-gray-600 text-xs"
                                      title={`Text ${deal.broker.phone}`}
                                      onClick={(e) => e.stopPropagation()}
                                    >
                                      SMS
                                    </a>
                                  </>
                                ) : (
                                  <span className="text-gray-400">No phone</span>
                                )}
                                <button
                                  className="text-gray-400 hover:text-gray-600 text-xs"
                                  onClick={() => startCellEdit(deal.id, 'brokerPhone', deal.broker.phone || '')}
                                  title="Edit phone"
                                >
                                  ✎
                                </button>
                              </div>
                            )}
                          </td>
                          {/* 22. Market */}
                          <td className="p-2 border-r border-catalyst-gray-200 text-catalyst-gray-700">
                            {editingRow === deal.id ? (
                              <Input
                                value={editData.market || deal.broker.marketsCovered || ''}
                                onChange={(e) => setEditData({...editData, market: e.target.value})}
                                className="h-8 text-xs"
                                placeholder="Market..."
                              />
                            ) : editingCell?.dealId === deal.id && editingCell?.field === 'market' ? (
                              <Input
                                value={cellEditValue}
                                onChange={(e) => setCellEditValue(e.target.value)}
                                onBlur={saveCellEdit}
                                onKeyDown={handleCellKeyPress}
                                className="h-8 text-xs"
                                placeholder="Market..."
                                autoFocus
                              />
                            ) : (
                              <div 
                                className={`max-w-[130px] truncate cursor-pointer hover:bg-gray-100 ${
                                  !deal.broker.marketsCovered ? 'text-gray-400' : ''
                                }`}
                                title={deal.broker.marketsCovered}
                                onClick={() => startCellEdit(deal.id, 'market', deal.broker.marketsCovered || '')}
                              >
                                {deal.broker.marketsCovered || 'Click to add...'}
                              </div>
                            )}
                          </td>
                          {/* 23. 55+ Population 5 Mile */}
                          <td className="p-2 border-r border-catalyst-gray-200 text-catalyst-gray-700">
                            {editingRow === deal.id ? (
                              <Input
                                type="number"
                                value={editData.population55Plus5Mile || ''}
                                onChange={(e) => setEditData({...editData, population55Plus5Mile: parseInt(e.target.value) || 0})}
                                className="h-8 text-xs"
                                placeholder="55+ pop..."
                              />
                            ) : editingCell?.dealId === deal.id && editingCell?.field === 'population55Plus5Mile' ? (
                              <Input
                                type="number"
                                value={cellEditValue}
                                onChange={(e) => setCellEditValue(e.target.value)}
                                onBlur={saveCellEdit}
                                onKeyDown={handleCellKeyPress}
                                className="h-8 text-xs"
                                placeholder="55+ pop..."
                                autoFocus
                              />
                            ) : (
                              <div 
                                className={`cursor-pointer hover:bg-gray-100 ${
                                  isFieldEmpty(deal.population55Plus5Mile) ? 'text-gray-400' : ''
                                }`}
                                onClick={() => (!deal.population55Plus5Mile || deal.population55Plus5Mile === 0) && startCellEdit(deal.id, 'population55Plus5Mile', deal.population55Plus5Mile)}
                                title={(!deal.population55Plus5Mile || deal.population55Plus5Mile === 0) ? 'Click to add 55+ population' : deal.population55Plus5Mile?.toString()}
                              >
                                {deal.population55Plus5Mile ? deal.population55Plus5Mile.toLocaleString() : 'Click to add...'}
                              </div>
                            )}
                          </td>
                          {/* 24. 55+ $75k+ Income */}
                          <td className="p-2 border-r border-catalyst-gray-200 text-catalyst-gray-700">
                            {editingRow === deal.id ? (
                              <Input
                                type="number"
                                value={editData.income75Plus55Plus || ''}
                                onChange={(e) => setEditData({...editData, income75Plus55Plus: parseInt(e.target.value) || 0})}
                                className="h-8 text-xs"
                                placeholder="$75k+ pop..."
                              />
                            ) : editingCell?.dealId === deal.id && editingCell?.field === 'income75Plus55Plus' ? (
                              <Input
                                type="number"
                                value={cellEditValue}
                                onChange={(e) => setCellEditValue(e.target.value)}
                                onBlur={saveCellEdit}
                                onKeyDown={handleCellKeyPress}
                                className="h-8 text-xs"
                                placeholder="$75k+ pop..."
                                autoFocus
                              />
                            ) : (
                              <div 
                                className={`cursor-pointer hover:bg-gray-100 ${
                                  isFieldEmpty(deal.income75Plus55Plus) ? 'text-gray-400' : ''
                                }`}
                                onClick={() => (!deal.income75Plus55Plus || deal.income75Plus55Plus === 0) && startCellEdit(deal.id, 'income75Plus55Plus', deal.income75Plus55Plus)}
                                title={(!deal.income75Plus55Plus || deal.income75Plus55Plus === 0) ? 'Click to add 55+ income data' : deal.income75Plus55Plus?.toString()}
                              >
                                {deal.income75Plus55Plus ? deal.income75Plus55Plus.toLocaleString() : 'Click to add...'}
                              </div>
                            )}
                          </td>
                          {/* 25. Demo Notes */}
                          <td className="p-2 border-r border-catalyst-gray-200 text-catalyst-gray-700">
                            {editingRow === deal.id ? (
                              <Input
                                value={editData.demographicsNotes || ''}
                                onChange={(e) => setEditData({...editData, demographicsNotes: e.target.value})}
                                className="h-8 text-xs"
                                placeholder="Demo notes..."
                              />
                            ) : editingCell?.dealId === deal.id && editingCell?.field === 'demographicsNotes' ? (
                              <Input
                                value={cellEditValue}
                                onChange={(e) => setCellEditValue(e.target.value)}
                                onBlur={saveCellEdit}
                                onKeyDown={handleCellKeyPress}
                                className="h-8 text-xs"
                                placeholder="Demo notes..."
                                autoFocus
                              />
                            ) : (
                              <div 
                                className={`max-w-[140px] truncate cursor-pointer hover:bg-gray-100 ${
                                  isFieldEmpty(deal.demographicsNotes) ? 'text-gray-400' : ''
                                }`}
                                onClick={() => isFieldEmpty(deal.demographicsNotes) && startCellEdit(deal.id, 'demographicsNotes', deal.demographicsNotes)}
                                title={isFieldEmpty(deal.demographicsNotes) ? 'Click to add demo notes' : (deal.demographicsNotes || '')}
                              >
                                {deal.demographicsNotes || 'Click to add...'}
                              </div>
                            )}
                          </td>
                          {/* 26. Submitted */}
                          <td className="p-2 border-r border-catalyst-gray-200 text-catalyst-gray-700 text-sm break-words max-w-[200px] overflow-hidden">
                            {editingRow === deal.id ? (
                              <Input
                                type="date"
                                value={editData.submittedDate || (deal.createdAt ? new Date(deal.createdAt).toISOString().split('T')[0] : '')}
                                onChange={(e) => setEditData({...editData, submittedDate: e.target.value})}
                                className="h-8 text-xs"
                              />
                            ) : editingCell?.dealId === deal.id && editingCell?.field === 'submittedDate' ? (
                              <Input
                                type="date"
                                value={cellEditValue}
                                onChange={(e) => setCellEditValue(e.target.value)}
                                onBlur={saveCellEdit}
                                onKeyDown={handleCellKeyPress}
                                className="h-8 text-xs"
                                autoFocus
                              />
                            ) : (
                              <div 
                                className="cursor-pointer hover:bg-gray-100"
                                onClick={() => startCellEdit(deal.id, 'submittedDate', deal.createdAt ? new Date(deal.createdAt).toISOString().split('T')[0] : '')}
                              >
                                {formatDate(deal.createdAt)}
                              </div>
                            )}
                          </td>
                          {/* 27. Notes */}
                          <td className="p-2 border-r border-catalyst-gray-200">
                            {editingRow === deal.id ? (
                              <Textarea
                                value={editData.analystNotes || ''}
                                onChange={(e) => setEditData({...editData, analystNotes: e.target.value})}
                                className="h-20 text-xs resize-none"
                                placeholder="Add notes..."
                              />
                            ) : (
                              <div className="max-w-[180px] max-h-16 overflow-hidden text-xs text-catalyst-gray-600">
                                {deal.analystNotes || 'No notes'}
                              </div>
                            )}
                          </td>
                          
                          {/* Custom Formula Columns */}
                          {Object.keys(customFormulas).map((columnName: string) => (
                            <td key={columnName} className="p-2 border-r border-catalyst-gray-200 text-catalyst-gray-700">
                              <div className="font-mono text-sm">
                                {calculatedFields[deal.id]?.[columnName] !== undefined ? (
                                  typeof calculatedFields[deal.id][columnName] === 'number' ? 
                                    calculatedFields[deal.id][columnName].toLocaleString() :
                                    calculatedFields[deal.id][columnName]
                                ) : (
                                  'N/A'
                                )}
                              </div>
                            </td>
                          ))}
                          
                          {/* Property Data Action */}
                          <td className="p-2 border-r border-catalyst-gray-200">
                            <div className="flex gap-1">
                              <Button
                                size="sm"
                                variant="outline"
                                onClick={() => setSelectedDealForProperty(deal.id)}
                                className="h-8 px-2 text-xs"
                                disabled={!deal.address}
                                data-testid={`button-property-data-${deal.id}`}
                              >
                                <BarChart3 size={14} className="mr-1" />
                                Property Data
                              </Button>
                              <Button
                                size="sm"
                                variant="outline"
                                onClick={() => autoFillDealMutation.mutate(deal.id)}
                                className="h-8 px-2 text-xs bg-blue-50 hover:bg-blue-100 border-blue-200 text-blue-700"
                                disabled={!deal.address || autoFillDealMutation.isPending}
                                data-testid={`button-auto-fill-${deal.id}`}
                              >
                                <Zap size={14} className="mr-1" />
                                {autoFillDealMutation.isPending ? 'Filling...' : 'Auto-Fill'}
                              </Button>
                            </div>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                    </div>
                  </div>
                </>
              )}
            </CardContent>
          </Card>

        </div>
      </div>
      
      {/* Formula Builder Modal */}
      {showFormulaBuilder && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <FormulaBuilder
            onAddFormula={addCustomColumn}
            onClose={() => {
              setShowFormulaBuilder(false);
              setFormulaError("");
            }}
            existingFormulas={customFormulas}
            error={formulaError}
          />
        </div>
      )}

      {/* Property Data Modal */}
      {selectedDealForProperty && (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-lg max-w-6xl w-full max-h-[90vh] overflow-y-auto">
            <div className="p-6">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-xl font-bold">Property Intelligence</h2>
                <Button
                  variant="ghost"
                  size="sm"
                  onClick={() => setSelectedDealForProperty(null)}
                  data-testid="button-close-property-modal"
                >
                  <X size={16} />
                </Button>
              </div>
              <PropertyDataPanel
                dealId={selectedDealForProperty}
                address={deals?.find((d: any) => d.id === selectedDealForProperty)?.address || ''}
              />
            </div>
          </div>
        </div>
      )}
      
      <Footer />
      </div>
    </div>
  );
}