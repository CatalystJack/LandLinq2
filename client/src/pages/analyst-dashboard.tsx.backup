                                onChange={(e) => setCellEditValue(e.target.value)}
                                onBlur={saveCellEdit}
                                onKeyDown={handleCellKeyPress}
                                className="h-8 text-xs"
                                placeholder="Margin/lot..."
                                autoFocus
