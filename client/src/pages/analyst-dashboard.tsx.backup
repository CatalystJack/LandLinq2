                                className="cursor-pointer hover:bg-gray-100 text-gray-400"
                                onClick={() => startCellEdit(deal.id, 'yieldOnCost', '')}
                              >
                                Click to add...
                              </div>
                            )}
                          </td>
                          {/* 17. Margins per Finished Lot */}
                          <td className="p-2 border-r border-catalyst-gray-200 text-catalyst-gray-700">
                            {editingRow === deal.id ? (
                              <Input
                                type="number"
                                value={editData.marginsPerLot || ''}
                                onChange={(e) => setEditData({...editData, marginsPerLot: parseFloat(e.target.value) || 0})}
                                className="h-8 text-xs"
                                placeholder="Margin/lot..."
                              />
