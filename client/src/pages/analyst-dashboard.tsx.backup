                                value={editData.rentComparable || ''}
                                onChange={(e) => setEditData({...editData, rentComparable: e.target.value})}
                                className="h-8 text-xs"
                                placeholder="Rent/unit..."
                              />
                            ) : editingCell?.dealId === deal.id && editingCell?.field === 'rentComparable' ? (
                              <Input
                                type="number"
                                value={cellEditValue}
                                onChange={(e) => setCellEditValue(e.target.value)}
                                onBlur={saveCellEdit}
                                onKeyDown={handleCellKeyPress}
                                className="h-8 text-xs"
                                placeholder="Rent/unit..."
                                autoFocus
                              />
                            ) : (
                              <div 
                                className={`cursor-pointer hover:bg-gray-100 ${
                                  isFieldEmpty(deal.rentComparable) ? 'text-gray-400' : ''
                                }`}
                                onClick={() => isFieldEmpty(deal.rentComparable) && startCellEdit(deal.id, 'rentComparable', deal.rentComparable)}
                                title={isFieldEmpty(deal.rentComparable) ? 'Click to add rent' : `$${deal.rentComparable}`}
                              >
                                {deal.rentComparable ? `$${deal.rentComparable}` : 'Click to add...'}
                              </div>
                            )}
                          </td>
                          {/* 16. Yield on Cost */}
                          <td className="p-2 border-r border-catalyst-gray-200 text-catalyst-gray-700">
                            {editingRow === deal.id ? (
                              <Input
                                type="number"
                                step="0.01"
                                value={editData.yieldOnCost || ''}
                                onChange={(e) => setEditData({...editData, yieldOnCost: parseFloat(e.target.value) || 0})}
                                className="h-8 text-xs"
                                placeholder="Yield %..."
                              />
                            ) : editingCell?.dealId === deal.id && editingCell?.field === 'yieldOnCost' ? (
                              <Input
                                type="number"
                                step="0.01"
                                value={cellEditValue}
                                onChange={(e) => setCellEditValue(e.target.value)}
                                onBlur={saveCellEdit}
                                onKeyDown={handleCellKeyPress}
                                className="h-8 text-xs"
                                placeholder="Yield %..."
                                autoFocus
